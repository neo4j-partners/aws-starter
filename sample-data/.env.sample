# sample-data — environment configuration
# Copy to .env and fill in your values:
#   cp .env.sample .env

# =============================================================================
# Neo4j Aura connection (required)
# =============================================================================
# Use the SAME instance the Neo4j MCP server points at
# (neo4j-agentcore-mcp-server/.env). The fleet-agent reads through the MCP
# server, so all three must agree on this database.

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here

# =============================================================================
# Dataset size (sampled vs full)
# =============================================================================
# false (default) — small dataset: nodes_readings.csv stays a few MB, loads in
#                    minutes, fits free/small Aura tiers. Answers every query in
#                    fleet-agent/queries.txt.
# true            — full dataset: ~100 aircraft x 90 days (~114MB of readings).
#                    Realistic but slow to load; needs a larger Aura tier.

LOAD_FULL_DATASET=false

# Optional fine-grained overrides (take precedence over LOAD_FULL_DATASET).
# Leave unset to use the size implied by LOAD_FULL_DATASET.
#GEN_AIRCRAFT=20
#GEN_DAYS=7
#GEN_AIRPORTS=40
#GEN_SEED=42

# =============================================================================
# GraphRAG enrichment LLM (required for `setup`)
# =============================================================================
# `setup` chunks the maintenance manuals in manuals/, embeds them with OpenAI,
# and extracts entities with the provider chosen below. Embeddings ALWAYS use
# OpenAI; LLM_PROVIDER only controls entity extraction.
#
# Run `./setup.sh load-operational` instead if you want CSV data only and no
# LLM calls (no API keys needed).

LLM_PROVIDER=openai

# OpenAI — required (embeddings always; extraction when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#OPENAI_EMBEDDING_DIMENSIONS=1536
#OPENAI_EXTRACTION_MODEL=gpt-5-mini
#OPENAI_EXTRACTION_MAX_COMPLETION_TOKENS=8000

# Anthropic — only when LLM_PROVIDER=anthropic (run `uv sync --extra anthropic`)
#ANTHROPIC_API_KEY=sk-ant-your-key-here
#ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-6
#ANTHROPIC_EXTRACTION_MAX_TOKENS=8000

# Chunking
#CHUNK_SIZE=800
#CHUNK_OVERLAP=100
#ENRICH_SAMPLE_SIZE=0
#SAMPLE_SIZE=10

# =============================================================================
# Data locations (managed by setup.sh — do not normally edit)
# =============================================================================
# setup.sh exports DATA_DIR and DOCUMENT_DIR as absolute paths before running
# the loader, so the vendored tool finds generated CSVs and the manuals.
#DATA_DIR=
#DOCUMENT_DIR=
