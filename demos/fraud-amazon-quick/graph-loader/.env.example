# fraud-graph-loader environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# fraud-graph-load, fraud-graph-enrich, and fraud-graph-analyze read these
# values to reach Neo4j directly. They can match the values in
# ../../../neo4j-mcp-server/.env.finance, so the agent queries the same graph.
NEO4J_URI=neo4j+s://your-database.databases.neo4j.io
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Aura Graph Analytics creates a temporary GDS session during enrichment. 2GB
# is the smallest supported tier for this demo dataset; increase if required.
#GDS_SESSION_MEMORY=2GB
