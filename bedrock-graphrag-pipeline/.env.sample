# bedrock-graphrag-pipeline — environment configuration
# Copy to .env and fill in your values:
#   cp .env.sample .env

# =============================================================================
# Neo4j Aura connection (required)
# =============================================================================
# Use the SAME instance the Neo4j MCP server points at
# (neo4j-agentcore-mcp-server/.env). The fleet-agent reads through the MCP
# server, so all three must agree on this database.

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here

# =============================================================================
# Dataset size (sampled vs full)
# =============================================================================
# false (default) — small dataset: ~20 aircraft x 90 days (~23MB readings,
#                    ~111 maintenance events). Loads in minutes, fits
#                    free/small Aura tiers. The 90-day window is required:
#                    maintenance events only fire after ~45+ days of sensor
#                    degradation, so a shorter window yields none.
# true            — full dataset: ~100 aircraft x 90 days (~114MB of readings).
#                    Realistic but slow to load; needs a larger Aura tier.

LOAD_FULL_DATASET=false

# Optional fine-grained overrides (take precedence over LOAD_FULL_DATASET).
# Leave unset to use the size implied by LOAD_FULL_DATASET.
#GEN_AIRCRAFT=20
#GEN_DAYS=90
#GEN_AIRPORTS=40
#GEN_SEED=42

# =============================================================================
# GraphRAG enrichment LLM (required for `setup`)
# =============================================================================
# `setup` chunks the maintenance manuals in manuals/, embeds the chunks, and
# extracts entities. LLM_PROVIDER selects the backend for BOTH the embeddings
# and the entity-extraction LLM.
#
#   bedrock   (default) — Amazon Bedrock: Titan Text Embeddings V2 + Claude.
#                          No API keys here; uses the standard AWS credential
#                          chain (env vars / ~/.aws / instance role).
#   openai               — OpenAI embeddings + OpenAI extraction.
#   anthropic            — OpenAI embeddings + Anthropic extraction
#                          (run `uv sync --extra anthropic`).
#
# Run `./setup.sh load-operational` instead if you want CSV data only and no
# LLM calls (no keys / no AWS needed).

LLM_PROVIDER=bedrock

# ── Amazon Bedrock (used when LLM_PROVIDER=bedrock) ─────────────────────────
# AWS creds come from the environment / ~/.aws — do not put them here.
# Pinned to us-east-1 (AgentCore region for this repo).
#BEDROCK_REGION=us-east-1
#BEDROCK_LLM_MODEL=global.anthropic.claude-sonnet-4-6
#BEDROCK_LLM_MAX_TOKENS=8000
#BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
#BEDROCK_EMBEDDING_DIMENSIONS=1024

# ── OpenAI (used when LLM_PROVIDER=openai; embeddings when =anthropic) ──────
#OPENAI_API_KEY=sk-your-key-here
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#OPENAI_EMBEDDING_DIMENSIONS=1536
#OPENAI_EXTRACTION_MODEL=gpt-5-mini
#OPENAI_EXTRACTION_MAX_COMPLETION_TOKENS=8000

# ── Anthropic (used when LLM_PROVIDER=anthropic) ───────────────────────────
#ANTHROPIC_API_KEY=sk-ant-your-key-here
#ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-6
#ANTHROPIC_EXTRACTION_MAX_TOKENS=8000

# Chunking
#CHUNK_SIZE=800
#CHUNK_OVERLAP=100
#ENRICH_SAMPLE_SIZE=0
#SAMPLE_SIZE=10

# =============================================================================
# Data locations (managed by setup.sh — do not normally edit)
# =============================================================================
# setup.sh exports DATA_DIR and DOCUMENT_DIR as absolute paths before running
# the loader, so the vendored tool finds generated CSVs and the manuals.
#DATA_DIR=
#DOCUMENT_DIR=
