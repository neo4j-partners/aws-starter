{
  "name": "fleetsupervisor",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "supervisor",
      "description": "Aircraft fleet supervisor with Maintenance and Operations specialists",
      "build": "CodeZip",
      "entrypoint": "server/runtime_app.py",
      "codeLocation": ".",
      "runtimeVersion": "PYTHON_3_12",
      "envVars": [
        {
          "name": "MODEL_ID",
          "value": "global.anthropic.claude-sonnet-5-5"
        },
        {
          "name": "GATEWAY_URL",
          "value": "REPLACE_WITH_FLEET_GATEWAY_URL"
        },
        {
          "name": "GATEWAY_CREDENTIAL_PROVIDER",
          "value": "fleet-gateway"
        }
      ],
      "protocol": "HTTP"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": []
}
