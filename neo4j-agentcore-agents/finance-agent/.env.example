# finance-agent environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# The agent loads this file for local runs and `agent.sh`. Existing
# environment variables are never overridden, so the deployed AgentCore
# Runtime uses its injected env vars instead of this file.

# =============================================================================
# Neo4j connection (required — Context Graph memory)
# =============================================================================
# Cross-session memory opens a direct Neo4j driver (no MCP server, no Gateway).
# Point it at the SAME Neo4j instance as the finance graph. Gateway/OAuth2
# credentials are NOT set here — they live in .mcp-credentials.json.

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_PASSWORD=your-password

# =============================================================================
# Model + region (optional; defaults shown)
# =============================================================================
# AWS credentials come from the standard chain: env vars, ~/.aws, or an
# instance role.

#MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
#AWS_REGION=us-west-2
