# Neo4j MCP Server - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# =============================================================================
# Deploying More Than One Neo4j Instance
# =============================================================================
#
# Name the file .env.NAME and pass --env NAME to every script. The suffix
# selects the config and its credentials together, so they cannot drift:
#
#   cp .env.sample .env.fleet
#   ./deploy.py --env fleet
#   ./deploy.py --env fleet credentials   # writes .mcp-credentials.fleet.json
#   ./cloud.sh --env fleet tools
#
# The stack name is derived from the suffix (neo4j-agentcore-mcp-server-fleet
# for --env fleet), which namespaces the Cognito domain, the IAM roles, the
# Gateway, and the Secrets Manager password path. Leave STACK_NAME unset and
# each deployment is separated automatically.
#
# Deployments that share one MCP server image can keep the same ECR_REPO_NAME
# and NEO4J_MCP_REPO; only the NEO4J_* values need to differ.

# =============================================================================
# Neo4j Database Connection (Required)
# =============================================================================

# Neo4j connection URI (e.g., neo4j+s://xxx.databases.neo4j.io)
NEO4J_URI=

# Neo4j database name
NEO4J_DATABASE=neo4j

# Neo4j credentials
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# =============================================================================
# Build Configuration (Required)
# =============================================================================

# Path to the local Neo4j MCP server repo to build the ARM64 image from
# (must contain a Dockerfile). Deployment fails with a clear message if unset.
NEO4J_MCP_REPO=

# =============================================================================
# AWS Configuration (Optional)
# =============================================================================

# AWS region for deployment (default: us-east-1)
#AWS_REGION=us-east-1

# CDK stack name. Leave unset: it defaults to neo4j-agentcore-mcp-server, with
# -NAME appended when --env NAME is used, which keeps deployments separate on
# its own. Set it only to override that, and keep it unique per deployment.
# Letters and digits joined by single hyphens, starting with a letter, and not
# containing aws/amazon/cognito (Cognito forbids those in the domain prefix).
# Every resource name in the stack derives from it, so there is also a length
# cap, computed in cdk/naming.py from whichever derived name has the least room
# (41 characters at present). No need to work it out: deploy.py checks the name
# before it builds anything and says which resource is over, and by how much.
#STACK_NAME=neo4j-agentcore-mcp-server

# ECR repository name (default: neo4j-mcp-server)
#ECR_REPO_NAME=neo4j-mcp-server

# Docker image tag (default: latest)
#IMAGE_TAG=latest
