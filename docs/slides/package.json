{
  "name": "aws-neo4j-slides",
  "version": "1.0.0",
  "private": true,
  "description": "Published Marp slide decks for AWS and Neo4j presentations",
  "scripts": {
    "preview": "marp --input-dir current --server --allow-local-files",
    "build": "npm run build:all",
    "build:all": "node scripts/build-theme-gallery.mjs all",
    "build:pdf": "node scripts/export-current.mjs pdf",
    "build:html": "node scripts/export-current.mjs html",
    "build:pptx": "node scripts/export-current.mjs pptx",
    "serve": "npm run build:all && python3 -m http.server 8080 --directory build"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.2",
    "@xmldom/xmldom": "0.9.12"
  }
}
