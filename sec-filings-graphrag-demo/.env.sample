# Copy this file to .env and replace the Neo4j values.
NEO4J_URI=neo4j+s://your-database-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me

# The AWS SDK credential chain is used. A named local profile is optional.
AWS_PROFILE=default
AWS_REGION=us-east-1

# Used by the final answer cell added in Phase 4.
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-sonnet-4-6
