# fleet-agent environment configuration
# Copy to .env and fill in your values:
#   cp .env.sample .env
#
# The `common` package loads this file on import, covering both local runs
# and `agent.sh`. Existing environment variables are never overridden, so the
# deployed AgentCore Runtime uses its injected env vars instead of this file.

# =============================================================================
# Neo4j connection (required)
# =============================================================================
# The fleet-agent connects directly to Neo4j, with no MCP server and no
# Gateway. Point it at the SAME instance `sample-data` populated, or vector
# search and Text2Cypher return nothing.

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# =============================================================================
# Model + region (optional; defaults shown)
# =============================================================================
# AWS credentials come from the standard chain: env vars, ~/.aws, or an
# instance role.

#MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
#AWS_REGION=us-west-2

# =============================================================================
# Vector index + embedder (optional; MUST match `sample-data`)
# =============================================================================
# Override only if `sample-data` ran with non-default embedding settings. The
# index name and dimensions must agree with how the graph was populated.

#VECTOR_INDEX_NAME=maintenanceChunkEmbeddings
#EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
#EMBED_DIMENSIONS=1024
