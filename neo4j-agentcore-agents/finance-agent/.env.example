# finance-agent environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# The agent loads this file for local runs and `agent.sh`. Existing
# environment variables are never overridden, so the deployed AgentCore
# Runtime uses its injected env vars instead of this file.

# =============================================================================
# NAMS memory (required)
# =============================================================================
# Create an API key at https://memory.neo4jlabs.com. It belongs in the local
# .env for development and is injected by agent.sh during cloud deploy.
MEMORY_API_KEY=nams_your-api-key

# Optional for a private or staging NAMS deployment.
#MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1
#MEMORY_WORKSPACE_ID=your-workspace-id

# =============================================================================
# Optional finance-graph loader only
# =============================================================================
# The agent accesses Neo4j through MCP and does not use these values. They are
# needed only by `finance-graph-load` and `finance-graph-enrich`, which seed
# the bundled synthetic fraud graph directly. These can match the values in
# ../../neo4j-agentcore-mcp-server/.env.
#NEO4J_URI=neo4j+s://your-database.databases.neo4j.io
#NEO4J_DATABASE=neo4j
#NEO4J_USERNAME=neo4j
#NEO4J_PASSWORD=your-neo4j-password


# =============================================================================
# Model + region (optional; defaults shown)
# =============================================================================
# AWS credentials come from the standard chain: env vars, ~/.aws, or an
# instance role.

#MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
#AWS_REGION=us-west-2
